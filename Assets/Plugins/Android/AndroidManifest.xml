<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.aalokbright.InfiniteDefense">

    <!-- ========================= -->
    <!--       必需权限（安全）     -->
    <!-- ========================= -->
    <uses-sdk android:minSdkVersion="23" />

    <!-- 网络访问权限（AdMob、Unity Web 请求） -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 网络状态权限（AdMob 需要） -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- WiFi 状态权限（可选但 AdMob 推荐） -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <application
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:requestLegacyExternalStorage="false"
        tools:replace="android:allowBackup">

        <!-- Apache HTTP legacy（Unity Ads/Plugins 某些版本需要） -->
        <uses-library
            android:name="org.apache.http.legacy"
            android:required="false" />

        <!-- Unity Main Activity -->
        <activity android:name="com.unity3d.player.UnityPlayerActivity"
                  android:theme="@style/UnityThemeSelector"
                  android:exported="false"> <!--Core Repair -->

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <meta-data android:name="unityplayer.UnityActivity" android:value="true" />
        </activity>

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-7029478247518346~7238525487" />

        <meta-data
            android:name="com.google.unity.ads.UNITY_VERSION"
            android:value="2022.3.53f1c1" />
            
    </application>
</manifest>
